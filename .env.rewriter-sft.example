# Copy desired values into your runtime .env when enabling SFT rewriter mode.
# Keep guardrails enabled so rule-based semantic checks still validate outputs.

REWRITER_MODEL_VARIANT=sft
REWRITER_INPUT_MODE=dynamic
REWRITER_ENABLE_POSTFILTER_GUARD=true
REWRITER_GUARD_MIN_KEYWORD_HITS=2

# Point rewriter to SFT checkpoints instead of RL checkpoints.
REWRITER_CHECKPOINT_DIR=/app/sft_checkpoints
